.venv/
.idea/
__pycache__/
*.py[cod]

results.csv
summary.txt

# Keep the outputs directory but do not track its contents.
outputs/*
!outputs/.gitkeep

# Keep legacy workflow data directories but do not track local inputs/results.
legacy_workflows/legacy_synthetic_optimization/data/*
!legacy_workflows/legacy_synthetic_optimization/data/.gitkeep

# Keep the legacy outputs directory but do not track generated results.
legacy_workflows/legacy_synthetic_optimization/outputs/*
!legacy_workflows/legacy_synthetic_optimization/outputs/.gitkeep

# Keep the data directory but do not track its contents.
data/*
!data/.gitkeep
!data/raw/
data/raw/*
!data/raw/.gitkeep
